# =====================================================================
#  Configuración del Sistema de Videovigilancia CV — Fase 1
#  Copia este archivo como `.env` y ajusta los valores.
#  Todos los campos son opcionales: si falta alguno se usa el valor por
#  defecto que aparece en la derecha.
# =====================================================================

# ---------------------------------------------------------------------
# CÁMARA
# ---------------------------------------------------------------------
# IP Webcam (Android) en la misma red WiFi:
CAMARA_URL=http://192.168.1.50:8080/video
# Webcam de la PC:   CAMARA_URL=0
# Celular por cable (tethering USB):   CAMARA_URL=http://192.168.42.129:8080/video
# Webcam virtual (DroidCam/Iriun):     CAMARA_URL=1
# Archivo de video:   CAMARA_URL=C:\videos\prueba.mp4
CAMARA_FPS=10                       # fotogramas analizados por segundo
REINTENTO_CAMARA_S=5                # segundos entre reintentos si no hay señal
CAMARA_BACKEND=auto                 # auto | dshow | msmf (solo webcam local)
CAMARA_BACKEND_REINTENTOS=3         # fallos seguidos antes de probar otro backend
CAMARA_CONGELADA_MAX=50             # fotogramas idénticos seguidos antes de reabrir
FRAME_WIDTH=640                     # ancho de trabajo del motor de visión
FRAME_HEIGHT=480
CALIDAD_JPEG=78

# ---------------------------------------------------------------------
# DETECCIÓN DE PERSONAS (YOLOv8)
# ---------------------------------------------------------------------
YOLO_WEIGHTS=yolov8n.pt              # yolov8n.pt | yolov8s.pt | yolov8m.pt
CONFIANZA_YOLO=0.40

# ---------------------------------------------------------------------
# RECONOCIMIENTO FACIAL (InsightFace / ArcFace)
# ---------------------------------------------------------------------
FACE_MODEL=buffalo_sc                # buffalo_sc (rápido) | buffalo_l (más preciso)
UMBRAL_FACIAL=0.55                   # similitud coseno mínima para autorizar
ROSTRO_MIN_PX=40                     # tamaño mínimo del rostro para reconocerlo
MARGEN_ROI=0.15                      # margen del recorte de la persona

# ---------------------------------------------------------------------
# ZONAS
# ---------------------------------------------------------------------
DETECTAR_SIN_ZONAS=1                 # sin zonas definidas -> evalúa toda la imagen
RECARGA_ZONAS_S=3                    # segundos entre recargas de zonas desde MySQL

# ---------------------------------------------------------------------
# ALARMAS Y EVENTOS
# ---------------------------------------------------------------------
ALERTA_SIN_ROSTRO=1                  # alertar si hay persona en zona sin rostro visible
COOLDOWN_AUTORIZADO_S=30             # no repetir evento autorizado antes de N segundos
COOLDOWN_ALARMA_S=15                 # no repetir alarma antes de N segundos
CONFIRMAR_DESCONOCIDO_N=6            # fotogramas seguidos para confirmar un desconocido
CONFIRMAR_DESCONOCIDO_SIM=0.60       # similitud entre fotogramas para la misma cara
PISTA_EXPIRA_S=2                     # segundos sin verse para olvidar la pista
UMBRAL_DUDA=0.40                     # desde aquí el aviso dice a quién se parece
ALARMA_SONORA=1                      # beep del sistema operativo
GUARDAR_SNAPSHOT_AUTORIZADO=0        # guardar foto también en accesos autorizados

# Telegram (opcional). Deja vacío si no lo usas.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# ---------------------------------------------------------------------
# MYSQL
# ---------------------------------------------------------------------
DB_USER=vigilancia
DB_PASS=vigilancia123
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vigilancia_cv

# ---------------------------------------------------------------------
# SERVIDORES
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
# URL que usa el frontend Streamlit para hablar con el backend
API_URL=http://127.0.0.1:8000
